<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:AIFileExplorer.Models"
        xmlns:vm="using:AIFileExplorer.ViewModels"
        x:Class="AIFileExplorer.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AI File Explorer — Day 6: Avalonia XAML"
        Width="960" Height="620"
        MinWidth="700" MinHeight="400">

    <!--
        DockPanel arranges children against its edges (Top, Bottom, Left, Right).
        The last child (FileList) gets the remaining space via LastChildFill="True".
    -->
    <DockPanel LastChildFill="True">

        <!-- ══ Toolbar ════════════════════════════════════════════════════════
             Grid replaces StackPanel here.
             ColumnDefinitions:
               Auto  — label shrinks/grows to fit its text content
               *     — TextBox takes ALL remaining width (star sizing)
               Auto  — Scan button hugs its own content
               Auto  — Status text hugs its own content
        ═══════════════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#1E1E2E"
                Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  RowDefinitions="Auto">

                <!-- Column 0: static "Path:" label -->
                <TextBlock Grid.Column="0"
                           Text="Path:"
                           VerticalAlignment="Center"
                           Foreground="#CDD6F4"
                           Margin="0,0,8,0"/>

                <!-- Column 1: path entry — two-way binding keeps CurrentPath in sync -->
                <TextBox Grid.Column="1"
                         Text="{Binding CurrentPath}"
                         VerticalContentAlignment="Center"
                         FontFamily="Monospace"
                         Margin="0,0,8,0"/>

                <!-- Column 2: action button — bound to the generated ScanCommand -->
                <Button Grid.Column="2"
                        Content="Scan"
                        Command="{Binding ScanCommand}"
                        Padding="16,4"
                        Margin="0,0,8,0"/>

                <!-- Column 3: status feedback — one-way binding from StatusText -->
                <TextBlock Grid.Column="3"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#6C7086"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- ══ Column headers ════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#181825"
                Padding="10,5">
            <Grid ColumnDefinitions="*,90,145,70">
                <TextBlock Grid.Column="0" Text="Name"
                           Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Size"
                           Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Modified"
                           Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Ext"
                           Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ File list ═════════════════════════════════════════════════════
             ItemsControl renders one item per FileSystemEntry in FileList.ItemsSource.
             DataTemplate describes the visual for *each* item.
             {Binding PropertyName} reads a property from the current item object.
        ═══════════════════════════════════════════════════════════════════════ -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:FileSystemEntry">
                        <Border Padding="10,1">
                            <Grid ColumnDefinitions="*,90,145,70">

                                <!-- DisplayName already contains leading spaces for indent -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           FontFamily="Monospace"
                                           FontSize="12"/>

                                <!-- DisplaySize formats bytes into KB/MB/GB -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplaySize}"
                                           FontFamily="Monospace"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="#A6E3A1"/>

                                <!--
                                    StringFormat applies a C# format string to the bound value.
                                    The extra {} at the start is an XAML escape so the parser
                                    doesn't confuse {0:…} with a binding expression.
                                -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding LastModified, StringFormat='{}{0:MM/dd/yy HH:mm}'}"
                                           FontFamily="Monospace"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="#89DCEB"/>

                                <!-- Extension is "" for directories, ".txt" etc. for files -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Extension}"
                                           FontFamily="Monospace"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="#89B4FA"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
