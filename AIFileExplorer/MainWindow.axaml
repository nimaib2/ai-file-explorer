<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:AIFileExplorer.Models"
        xmlns:vm="using:AIFileExplorer.ViewModels"
        x:Class="AIFileExplorer.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AI File Explorer — Day 17: NL Search"
        Width="1100" Height="680"
        MinWidth="700" MinHeight="400">

    <!--
        KeyBindings wire gestures to ViewModel commands globally for the window.
        InputGesture on MenuItem (below) only shows the hint text in the menu —
        it does NOT handle the keystroke. These KeyBindings do the actual work.
    -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+C"  Command="{Binding CopyCommand}"/>
        <KeyBinding Gesture="Cmd+C"   Command="{Binding CopyCommand}"/>
        <KeyBinding Gesture="Ctrl+X"  Command="{Binding CutCommand}"/>
        <KeyBinding Gesture="Cmd+X"   Command="{Binding CutCommand}"/>
        <KeyBinding Gesture="Ctrl+V"  Command="{Binding PasteCommand}"/>
        <KeyBinding Gesture="Cmd+V"   Command="{Binding PasteCommand}"/>
        <KeyBinding Gesture="Delete"  Command="{Binding DeleteCommand}"/>
        <KeyBinding Gesture="F2"      Command="{Binding RenameCommand}"/>
        <KeyBinding Gesture="Back"    Command="{Binding NavigateUpCommand}"/>
        <KeyBinding Gesture="Cmd+Up"  Command="{Binding NavigateUpCommand}"/>
    </Window.KeyBindings>

    <!--
        DockPanel is the outermost container. Children docked to Top/Bottom are
        measured first and given their natural height; the last child (the main
        Grid) fills whatever space is left. LastChildFill="True" is the default
        but is written explicitly here for clarity.
    -->
    <DockPanel LastChildFill="True">

        <!-- ══ Toolbar (top) ══════════════════════════════════════════════════
             Two controls share the bar: address bar (stretches) and search box
             (fixed width). Both sit in a Grid so star-sizing works.
        ══════════════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#1E1E2E"
                Padding="10,8">
            <Grid ColumnDefinitions="Auto,Auto,*,180,Auto">

                <!-- Column 0: Up button — navigates to parent directory -->
                <Button Grid.Column="0"
                        Content="↑"
                        Command="{Binding NavigateUpCommand}"
                        Padding="10,4"
                        Margin="0,0,6,0"
                        ToolTip.Tip="Go to parent folder (Backspace / Cmd+Up)"/>

                <!-- Column 1: static label -->
                <TextBlock Grid.Column="1"
                           Text="Path:"
                           VerticalAlignment="Center"
                           Foreground="#CDD6F4"
                           Margin="0,0,8,0"/>

                <!-- Column 2: address bar — fills all spare width -->
                <TextBox Grid.Column="2"
                         Text="{Binding CurrentPath}"
                         VerticalContentAlignment="Center"
                         FontFamily="Monospace"
                         Margin="0,0,8,0"/>

                <!--
                    Column 3: search box — fixed 180 px.
                    Text is two-way bound; OnSearchTextChanged in the ViewModel
                    refilters Entries every time the user types a character.
                -->
                <TextBox Grid.Column="3"
                         Text="{Binding SearchText}"
                         PlaceholderText="Search…"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"/>

                <!-- Column 4: Navigate button — triggers NavigateCommand -->
                <Button Grid.Column="4"
                        Content="Go"
                        Command="{Binding NavigateCommand}"
                        Padding="16,4"/>
            </Grid>
        </Border>

        <!-- ══ AI search bar ══════════════════════════════════════════════════
             Separate band below the address bar.
             Row 0: input + buttons.  Row 1: indeterminate progress bar
             (3 px tall, only visible while IsSearching is true).
        ══════════════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#181825"
                Padding="10,6,10,4"
                BorderBrush="#313244"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,3">

                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto,Auto">

                    <TextBlock Grid.Column="0"
                               Text="AI Search:"
                               VerticalAlignment="Center"
                               Foreground="#CBA6F7"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"/>

                    <!--
                        Two-way binding so Enter triggers the command via KeyBinding.
                        PlaceholderText gives the user an example of the query format.
                    -->
                    <TextBox Grid.Column="1"
                             Text="{Binding NlQueryText}"
                             PlaceholderText="e.g. large PDFs from last month in Downloads"
                             VerticalContentAlignment="Center"
                             Margin="0,0,6,0">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Return"
                                        Command="{Binding NlSearchCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Button Grid.Column="2"
                            Content="Search"
                            Command="{Binding NlSearchCommand}"
                            Padding="14,4"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding !IsSearching}"/>

                    <!--
                        Clear button: visible only while showing results or searching,
                        so it appears only when there is something to clear.
                    -->
                    <Button Grid.Column="3"
                            Content="×"
                            Command="{Binding ClearNlSearchCommand}"
                            Padding="10,4"
                            ToolTip.Tip="Clear search results"/>
                </Grid>

                <!--
                    Indeterminate ProgressBar used as a spinner.
                    IsVisible collapses it to zero height when not searching,
                    so it takes no space at rest.
                -->
                <ProgressBar Grid.Row="1"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsSearching}"
                             Foreground="#CBA6F7"
                             Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- ══ Status bar (bottom) ════════════════════════════════════════════
             Docked to Bottom so it is measured before the main content area.
             Two TextBlocks: count on the left, selection detail on the right.
        ══════════════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="#181825"
                Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding FileCountText}"
                           Foreground="#A6ADC8"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectionText}"
                           Foreground="#89B4FA"
                           FontSize="11"
                           FontFamily="Monospace"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ Main content: two-pane layout ══════════════════════════════════
             A Grid with three columns:
               0  — left pane  (starts at 220 px, user can drag)
               1  — splitter   (4 px drag handle)
               2  — right pane (takes all remaining space)

             GridSplitter sits in column 1 and adjusts columns 0 and 2 as the
             user drags. ResizeDirection="Columns" is required; without it the
             splitter defaults to resizing rows.
        ══════════════════════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="220,4,*">

            <!-- ── Left pane: directory TreeView ──────────────────────────── -->
            <Border Grid.Column="0" Background="#181825">
                <!--
                    TreeView renders a hierarchical list. ItemsSource provides
                    the root-level nodes (DirectoryTree from the ViewModel).

                    HierarchicalDataTemplate is the key difference from a plain
                    DataTemplate: its ItemsSource attribute tells Avalonia which
                    property on each node contains that node's children. Avalonia
                    recurses automatically — no depth limit, no manual looping.

                    SelectionChanged is wired to code-behind (MainWindow.axaml.cs)
                    because the handler needs the selected node object to call
                    node.LoadChildren() — a UI-layer concern not appropriate for
                    the ViewModel directly.
                -->
                <!--
                    ItemsSource binds to FileSystem.Roots — the sub-ViewModel
                    that owns the tree. The View reaches through the dot without
                    any extra wiring in MainWindowViewModel.

                    The Styles block binds TreeViewItem.IsExpanded two-way to
                    DirectoryNodeViewModel.IsExpanded. When the user clicks the
                    expand arrow, Avalonia sets IsExpanded = true on the item
                    container; the binding propagates that back to the ViewModel
                    property, which triggers OnIsExpandedChanged → LoadChildren().
                    This is the expand-triggered lazy loading for Day 9.
                -->
                <TreeView ItemsSource="{Binding FileSystem.Roots}"
                          SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                          Background="Transparent">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem"
                               x:DataType="vm:DirectoryNodeViewModel">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="vm:DirectoryNodeViewModel"
                                          ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       Padding="2,1"/>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- ── Splitter ────────────────────────────────────────────────── -->
            <!--
                GridSplitter must be in its own column (column 1 here).
                It resizes the adjacent columns when dragged.
                Width/Height are constrained by the column/row definitions.
            -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="#313244"
                          HorizontalAlignment="Stretch"/>

            <!-- ── Right pane: file list ───────────────────────────────────── -->
            <!--
                DockPanel inside the right column so the column header can be
                docked to the top and the ListBox fills the rest.
            -->
            <DockPanel Grid.Column="2">

                <!--
                    Column headers — flat Buttons so clicking sorts the list.
                    CommandParameter passes the column name string to SortByCommand.
                    The ViewModel appends ↑/↓ to the active column's header text.
                    Column widths must match the Grid inside each ListBox item.
                -->
                <Border DockPanel.Dock="Top"
                        Background="#181825"
                        Padding="10,0">
                    <Grid ColumnDefinitions="28,*,90,145,70">
                        <!-- Column 0: icon gutter — no header needed -->
                        <TextBlock Grid.Column="0"/>

                        <Button Grid.Column="1"
                                Content="{Binding NameHeader}"
                                Command="{Binding SortByCommand}"
                                CommandParameter="Name"
                                Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,5" HorizontalContentAlignment="Left"/>
                        <Button Grid.Column="2"
                                Content="{Binding SizeHeader}"
                                Command="{Binding SortByCommand}"
                                CommandParameter="Size"
                                Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,5" HorizontalContentAlignment="Right"
                                HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="3"
                                Content="{Binding ModifiedHeader}"
                                Command="{Binding SortByCommand}"
                                CommandParameter="Modified"
                                Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,5" HorizontalContentAlignment="Right"
                                HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="4"
                                Content="{Binding ExtHeader}"
                                Command="{Binding SortByCommand}"
                                CommandParameter="Ext"
                                Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                                Background="Transparent" BorderThickness="0"
                                Padding="0,5" HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!--
                    ListBox rather than ItemsControl because we need SelectedItem
                    two-way binding for the status bar's selection info.

                    The Styles block overrides the default ListBoxItem padding so
                    each row's inner Grid aligns with the header Grid above.
                    HorizontalContentAlignment="Stretch" is required — without it
                    the Grid inside each item would shrink to its content width
                    instead of filling the full row.
                -->
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         Background="Transparent"
                         DoubleTapped="OnFileDoubleTapped">
                    <!--
                        ContextMenu attaches to the ListBox as a whole.
                        x:DataType is required for compiled bindings because
                        ContextMenu is a popup — it's not in the visual tree,
                        so it can't inherit x:DataType from the Window element.
                        Commands with CanExecute = HasSelection are automatically
                        greyed out when nothing is selected.

                        InputGesture on each MenuItem shows the keyboard hint
                        in the menu label. The actual shortcut handling is done
                        by Window.KeyBindings above.
                    -->
                    <ListBox.ContextMenu>
                        <ContextMenu x:DataType="vm:MainWindowViewModel">
                            <MenuItem Header="Open"
                                      Command="{Binding OpenCommand}"/>
                            <Separator/>
                            <MenuItem Header="Copy"
                                      Command="{Binding CopyCommand}"
                                      InputGesture="Ctrl+C"/>
                            <MenuItem Header="Cut"
                                      Command="{Binding CutCommand}"
                                      InputGesture="Ctrl+X"/>
                            <MenuItem Header="Paste"
                                      Command="{Binding PasteCommand}"
                                      InputGesture="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="Rename…"
                                      Command="{Binding RenameCommand}"
                                      InputGesture="F2"/>
                            <MenuItem Header="Delete"
                                      Command="{Binding DeleteCommand}"
                                      InputGesture="Delete"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:FileSystemEntry">
                            <Grid ColumnDefinitions="28,*,90,145,70">

                                <!-- Icon column: emoji for file type or folder -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontFamily="Monospace"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplaySize}"
                                           FontFamily="Monospace"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#A6E3A1"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding LastModified, StringFormat='{}{0:MM/dd/yy HH:mm}'}"
                                           FontFamily="Monospace"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#89DCEB"/>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding Extension}"
                                           FontFamily="Monospace"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#89B4FA"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
