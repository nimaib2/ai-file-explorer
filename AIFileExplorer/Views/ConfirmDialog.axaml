<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AIFileExplorer.Views.ConfirmDialog"
        Title="Confirm"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="20">

        <!--
            Buttons docked to the bottom so they stay pinned regardless of
            how tall the message text grows.
        -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Click="OnCancel"/>
            <Button Content="Delete" Width="80" Click="OnConfirm"/>
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
    </DockPanel>
</Window>
